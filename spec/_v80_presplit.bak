    std::string emotionalState;          // "calm", "desperate", "resigned", "urgent"
    std::vector<std::string> keyFacts;   // specific facts that must appear in script
    float degradation = 0.0f;            // static/wear on tape
    std::string outText;                 // audio script (fed to TTS or player override)
};
// M13 update pass: reg.view<HolotapeScriptComponent>().each([](entt::entity entity, auto& c) {
