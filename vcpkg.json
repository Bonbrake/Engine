{
  "name": "zombie-engine",
  "version": "0.1.0",
  "dependencies": [
    "catch2",
    "cxxopts",
    "enkits",
    "entt",
    "fastgltf",
    "glm",
    {
      "name": "imgui",
      "features": ["sdl3-binding", "vulkan-binding", "freetype"]
    },
    {
      "name": "joltphysics",
      "features": ["cross-platform-deterministic", "debugrenderer"]
    },
    {
      "name": "msdfgen",
      "default-features": false,
      "features": ["extensions"]
    },
    "nlohmann-json",
    {
      "name": "sdl3",
      "features": ["vulkan"]
    },
    "spdlog",
    "stb",
    "vk-bootstrap",
    "volk",
    "vulkan-memory-allocator",
    "shaderc",
    "spirv-reflect",
    "tracy"
  ]
}