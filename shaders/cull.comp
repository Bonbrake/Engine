#version 450
layout(local_size_x = 64) in;

struct InstanceData {
    vec4 position_radius;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0, std430) readonly buffer InstanceBuffer {
    InstanceData instances[];
};

layout(set = 0, binding = 1, std430) writeonly buffer IndirectBuffer {
    DrawIndexedIndirectCommand cmds[];
};

layout(set = 0, binding = 2, std430) buffer CountBuffer {
    uint drawCount;
};

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    uint instanceCount;
    uint frameCounter; // 0 for frame 1
    uint cullEnabled;
} pc;

layout(set = 0, binding = 3) uniform sampler2D depthPyramid;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.instanceCount) return;

    vec4 posRad = instances[idx].position_radius;
    vec3 center = posRad.xyz;
    float radius = posRad.w;

    // View-projection
    vec4 clip = pc.viewProj * vec4(center, 1.0);
    // Avoid division by zero
    if (clip.w <= 0.0) return; 
    vec3 ndc = clip.xyz / clip.w;
    
    // Frustum cull (rough sphere check in NDC)
    bool visible = true;
    if (pc.cullEnabled != 0) {
        if (abs(ndc.x) > 1.0 + radius || abs(ndc.y) > 1.0 + radius || ndc.z < 0.0 || ndc.z > 1.0) {
            visible = false;
        }
    }

    // Hi-Z cull using previous frame depth
    if (visible && pc.cullEnabled != 0 && pc.frameCounter > 3) {
        vec2 uv = ndc.xy * 0.5 + 0.5;
        // In Vulkan Y goes down, so flip Y for UV
        // actually depends on viewport, but we can just use 1.0 - y if needed.
        uv.y = 1.0 - uv.y;
        
        // Very basic single-level depth test for now
        float sceneDepth = textureLod(depthPyramid, uv, 0.0).r;
        float myDepth = ndc.z - radius * 0.1; // approximate closest point
        // In reverse-Z, closer is higher (1.0). But TriangleRenderer uses standard Z (0.0 to 1.0, LESS_OR_EQUAL)
        // Standard Z: closer is lower. So if myDepth > sceneDepth, I am occluded.
        if (myDepth > sceneDepth) {
            visible = false;
        }
    }

    if (visible) {
        uint outIdx = atomicAdd(drawCount, 1);
        cmds[outIdx].indexCount = 3;
        cmds[outIdx].instanceCount = 1;
        cmds[outIdx].firstIndex = 0;
        cmds[outIdx].vertexOffset = 0;
        cmds[outIdx].firstInstance = idx;
    }
}
